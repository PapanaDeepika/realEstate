{
  "expo": {
    "name": "RealEstate Lokam",
    "slug": "projectmobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "googleServicesFile": "./google-services.json",

      "adaptiveIcon": {
        "foregroundImage": "./assets/landingpageupdate.jpg"   
       },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ],
      "package": "com.indu_panchireddi.projectmobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location."
        }
      ],
      "expo-localization",
      "expo-font"
    ],
    "locales": {
      "en": "./en.json",
      "te": "./te.json"
    },
    "extra": {
      "eas": {
        "projectId": "f6664a9d-b5f2-4060-bf7b-d49275a5066c"
      }
    },
    "notification": {
  "icon": "./assets/landingpageupdate.jpg",
  "color":"#d3f2e5"
 }

  }
}
